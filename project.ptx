<project ptx-version="2">
  <!-- One target per session, named `sessionN`. Each deploys to its own
       `sessionN/` directory so the live URL is
       https://ecartee.github.io/math152-hogu-sp26/sessionN/
       and the per-target index.html files never collide. Keep targets in
       numeric order; adding a session means adding a target here and a row
       in site/index.html. -->
